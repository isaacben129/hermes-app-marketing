# Central marketing service settings (non-secret; optional).
# Keep the API key in a private central secrets file outside this repository.
# Point the local launcher at it with HERMES_MARKETING_SECRETS_FILE.
HERMES_MARKETING_DATA_DIR=/opt/data/cache/marketing-system
HERMES_MARKETING_SERVICE_PORT=8764
HERMES_MARKETING_RENDERER_PORT=8765
HERMES_MARKETING_ALLOWED_ORIGIN=null
